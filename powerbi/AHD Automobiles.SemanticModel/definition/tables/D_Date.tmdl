	column 'Ordre trimestre'
		dataType: int64
		formatString: 0
		isHidden
		lineageTag: 4cbd7107-3bf8-5075-bfbe-447860337822
		summarizeBy: none
		sourceColumn: TrimAnneeN

		annotation SummarizationSetBy = Automatic

	partition D_Date = m
		mode: import
		source =
				let
				    Debut = #date(2015, 1, 1),
				    Jours = List.Dates(Debut, Duration.Days(#date(2018, 12, 31) - Debut) + 1, #duration(1, 0, 0, 0)),
				    MoisFr = {"Janv.", "Févr.", "Mars", "Avr.", "Mai", "Juin", "Juil.", "Août", "Sept.", "Oct.", "Nov.", "Déc."},
				    Lignes = List.Transform(Jours, (d) => let y = Date.Year(d), m = Date.Month(d) in
				        [Date = d, Annee = y, MoisN = m, Mois = MoisFr{m - 1}, Trimestre = "T" & Text.From(Date.QuarterOfYear(d)),
				         DebutMois = #date(y, m, 1), MoisAnnee = MoisFr{m - 1} & " " & Text.From(y), MoisAnneeN = y * 100 + m,
				         TrimAnnee = "T" & Text.From(Date.QuarterOfYear(d)) & " " & Text.From(y), TrimAnneeN = y * 10 + Date.QuarterOfYear(d)]),
				    Tableau = Table.FromRecords(Lignes),
				    Types = Table.TransformColumnTypes(Tableau, {{"Date", type date}, {"Annee", Int64.Type}, {"MoisN", Int64.Type}, {"Mois", type text}, {"Trimestre", type text}, {"DebutMois", type date}, {"MoisAnnee", type text}, {"MoisAnneeN", Int64.Type}, {"TrimAnnee", type text}, {"TrimAnneeN", Int64.Type}}, "en-US")
				in
				    Types

	annotation PBI_ResultType = Table
