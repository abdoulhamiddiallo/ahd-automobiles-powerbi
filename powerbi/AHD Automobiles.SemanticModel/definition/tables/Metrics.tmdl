		displayFolder: 07 Classements
		lineageTag: f53fd8a4-de36-5794-b202-3d5415972018

	/// Modèles du top 8 des ventes
	measure 'Top Marge' = IF ( [Rang modèle] <= 8, [Marge brute] )
		formatString: #,0" £"
		displayFolder: 07 Classements
		lineageTag: 73fad234-3b72-5229-b342-d1558f0f619f

