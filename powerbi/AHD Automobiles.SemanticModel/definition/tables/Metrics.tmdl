	/// Jours entre l'achat et le 31 décembre 2018 pour les voitures non vendues
	measure 'Âge moyen du stock' = CALCULATE ( AVERAGE ( F_Stock[Âge (jours)] ), F_Stock[Statut] = "En stock" )
		formatString: 0" j"
		displayFolder: 06 Stock
		lineageTag: f0373814-f077-551c-aeec-b2c9440aebad

	measure 'Taux d''écoulement' = DIVIDE ( CALCULATE ( COUNTROWS ( F_Stock ), F_Stock[Statut] = "Vendue" ), [Voitures achetées] )
		formatString: 0 %
		displayFolder: 06 Stock
		lineageTag: 533a8354-8a89-5e6a-b9b6-fce37591d96c

	/// Jours moyens entre l'achat et la vente (lignes cohérentes)
	measure 'Délai de vente' = AVERAGEX ( FILTER ( F_Ventes, F_Ventes[Jours en stock] >= 0 ), F_Ventes[Jours en stock] )
		formatString: 0" j"
		displayFolder: 06 Stock
		lineageTag: 88bfd9a3-70e4-5af8-9182-bf7ccf703b1b

	measure 'Ventes en 30 jours' = DIVIDE ( COUNTROWS ( FILTER ( F_Ventes, F_Ventes[Jours en stock] >= 0 && F_Ventes[Jours en stock] <= 30 ) ), [Voitures vendues] )
		formatString: 0 %
		displayFolder: 06 Stock
		lineageTag: 18763e61-ee1d-5cae-a5bd-57ac68e34eec

	/// Valeur de l'indicateur choisi dans le sélecteur
	measure Indicateur = ```
			VAR s = SELECTEDVALUE ( D_Indicateur[Indicateur], "Ventes" )
			RETURN SWITCH ( s, "Marge brute", [Marge brute] / 1000, "Voitures vendues", [Voitures vendues], [Ventes] / 1000 )
			```
		displayFolder: 07 Classements
		lineageTag: 5424c34b-8431-51d3-b562-634a2e2c36c9

		formatStringDefinition = SWITCH ( SELECTEDVALUE ( D_Indicateur[Indicateur], "Ventes" ), "Voitures vendues", "#,0", "#,0 ""k£""" )

	measure 'Rang marque' = IF ( ISINSCOPE ( D_Modele[Marque] ), CALCULATE ( RANKX ( ALLSELECTED ( D_Modele[Marque] ), [Indicateur], , DESC, DENSE ), REMOVEFILTERS ( D_Modele[Logo], D_Modele[Origine], D_Modele[Catégorie], D_Modele[Positionnement] ) ) )
		formatString: 0
		displayFolder: 07 Classements
		lineageTag: f84f0178-922f-5268-9094-87bd2fa42c2d

	measure 'Indicateur top 10 marques' = IF ( [Rang marque] <= 10, [Indicateur] )
		displayFolder: 07 Classements
		lineageTag: 0fe7c2fd-785e-5190-8444-1b14d8838474

		formatStringDefinition = SWITCH ( SELECTEDVALUE ( D_Indicateur[Indicateur], "Ventes" ), "Voitures vendues", "#,0", "#,0 ""k£""" )

	/// Rang sur toutes les colonnes de D_Modele, pour rester juste quand le tableau affiche aussi l'univers
	measure 'Rang modèle' = IF ( ISINSCOPE ( D_Modele[Modèle complet] ), RANKX ( ALLSELECTED ( D_Modele ), [Ventes], , DESC, DENSE ) )
		formatString: 0
		displayFolder: 07 Classements
		lineageTag: 9db4baa9-9fd3-5130-8def-b9bccef3602d

	/// Modèles du top 8 des ventes
	measure 'Top Voitures' = IF ( [Rang modèle] <= 8, [Voitures vendues] )
		formatString: #,0
		displayFolder: 07 Classements
		lineageTag: 298660e7-b0fe-52d6-81b4-3a14f4724ff6

	/// Modèles du top 8 des ventes
	measure 'Top Ventes' = IF ( [Rang modèle] <= 8, [Ventes] )
