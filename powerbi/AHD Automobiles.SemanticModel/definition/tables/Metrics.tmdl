	/// Rang du client, insensible aux colonnes ville, pays et type affichées dans le tableau
	measure 'Rang client' = IF ( ISINSCOPE ( D_Client[Client] ), RANKX ( ALLSELECTED ( D_Client ), CALCULATE ( [Ventes], ALLSELECTED ( D_Pays ) ), , DESC, DENSE ) )
