	/// Montant de chaque étape, du coût d'achat au prix de vente
	measure 'Montant étape k£' = ```
			DIVIDE ( SWITCH ( SELECTEDVALUE ( D_Etape[Étape] ),
			    "Coût d'achat", [Coût achat],
			    "Réparations", SUM ( F_Ventes[Réparations] ),
			    "Pièces", SUM ( F_Ventes[Pièces] ),
			    "Transport", SUM ( F_Ventes[Transport] ),
			    "Marge brute", [Marge brute] ), 1000 )
			```
		formatString: #,0 "k£"
		displayFolder: 02 Rentabilité
		lineageTag: 42c8265b-c704-5d58-a350-313f063ee68b

