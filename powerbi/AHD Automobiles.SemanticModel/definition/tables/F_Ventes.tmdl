		annotation SummarizationSetBy = Automatic

	partition F_Ventes = m
		mode: import
		source =
				let
				    Source = Sql.Database(Serveur, Base),
				    N = (x) => if x = null then 0 else Number.From(x),
				    T = (x) => if x = null then null else Text.Trim(Text.From(x)),
				    CouleursFr = [#"Black" = "Noir", #"Blue" = "Bleu", #"British Racing Green" = "Vert anglais", #"Canary Yellow" = "Jaune canari", #"Dark Purple" = "Pourpre", #"Green" = "Vert", #"Night Blue" = "Bleu nuit", #"Pink" = "Rose", #"Red" = "Rouge", #"Silver" = "Argent"],
				    CouleurFr = (c) => if c = null then "Non renseignée" else Record.FieldOrDefault(CouleursFr, Text.Trim(c), Text.Trim(c)),
				    Ventes0 = Source{[Schema = "Data", Item = "Sales"]}[Data],
				    Lignes0 = Source{[Schema = "Data", Item = "SalesDetails"]}[Data],
				    Stock0 = Source{[Schema = "Data", Item = "Stock"]}[Data],
				    J1 = Table.NestedJoin(Lignes0, {"SalesID"}, Ventes0, {"SalesID"}, "V", JoinKind.Inner),
				    E1 = Table.ExpandTableColumn(J1, "V", {"CustomerID", "InvoiceNumber", "SaleDate"}, {"CustomerID", "InvoiceNumber", "SaleDate"}),
				    J2 = Table.NestedJoin(E1, {"StockID"}, Stock0, {"StockCode"}, "S", JoinKind.Inner),
				    E2 = Table.ExpandTableColumn(J2, "S", {"ModelID", "Cost", "RepairsCost", "PartsCost", "TransportInCost", "IsRHD", "Color", "DateBought"}, {"ModelID", "Cost", "RepairsCost", "PartsCost", "TransportInCost", "IsRHD", "Color", "DateBought"}),
				    Gammes = {{25000, "10-25 k£", 1}, {50000, "25-50 k£", 2}, {75000, "50-75 k£", 3}, {100000, "75-100 k£", 4}, {150000, "100-150 k£", 5}, {250000, "150-250 k£", 6}},
				    GammeDe = (p as number) => let g = List.Select(Gammes, each p <= _{0}) in if List.IsEmpty(g) then {0, "> 250 k£", 7} else g{0},
				    Lignes = List.Transform(Table.ToRecords(E2), (r) =>
				        let d = Date.From(r[SaleDate]), a = Date.From(r[DateBought]), p = N(r[SalePrice]),
				            ca = N(r[Cost]), re = N(r[RepairsCost]), pi = N(r[PartsCost]), tr = N(r[TransportInCost]), g = GammeDe(p)
				        in [LigneID = Int64.From(r[SalesDetailsID]), VenteID = Int64.From(r[SalesID]), Facture = T(r[InvoiceNumber]),
				            Date = d, ClientID = T(r[CustomerID]), StockID = T(r[StockID]), ModeleID = if r[ModelID] = null then -1 else Int64.From(r[ModelID]),
				            PrixVente = p, Remise = N(r[LineItemDiscount]), CoutAchat = ca, Reparations = re, Pieces = pi, Transport = tr,
				            CoutTotal = ca + re + pi + tr, Marge = p - (ca + re + pi + tr), Couleur = CouleurFr(r[Color]),
				            Conduite = if r[IsRHD] = true then "Volant à droite" else "Volant à gauche",
				            DateAchat = a, JoursStock = Duration.Days(d - a), Gamme = g{1}, GammeOrdre = g{2}]),
				    Tableau = Table.FromRecords(Lignes),
				    Types = Table.TransformColumnTypes(Tableau, {{"LigneID", Int64.Type}, {"VenteID", Int64.Type}, {"Facture", type text}, {"Date", type date}, {"ClientID", type text}, {"StockID", type text}, {"ModeleID", Int64.Type}, {"PrixVente", type number}, {"Remise", type number}, {"CoutAchat", type number}, {"Reparations", type number}, {"Pieces", type number}, {"Transport", type number}, {"CoutTotal", type number}, {"Marge", type number}, {"Couleur", type text}, {"Conduite", type text}, {"DateAchat", type date}, {"JoursStock", Int64.Type}, {"Gamme", type text}, {"GammeOrdre", Int64.Type}}, "en-US")
				in
				    Types

	annotation PBI_ResultType = Table
