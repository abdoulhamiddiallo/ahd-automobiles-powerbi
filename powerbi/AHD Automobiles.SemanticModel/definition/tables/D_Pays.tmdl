	column Drapeau
		dataType: string
		dataCategory: ImageUrl
		lineageTag: ec504e22-8992-574b-bf71-9068f6999529
		summarizeBy: none
		sourceColumn: Drapeau

		annotation SummarizationSetBy = Automatic

	partition D_Pays = m
		mode: import
		source =
				let
				    Source = Sql.Database(Serveur, Base),
				    N = (x) => if x = null then 0 else Number.From(x),
				    T = (x) => if x = null then null else Text.Trim(Text.From(x)),
				    CouleursFr = [#"Black" = "Noir", #"Blue" = "Bleu", #"British Racing Green" = "Vert anglais", #"Canary Yellow" = "Jaune canari", #"Dark Purple" = "Pourpre", #"Green" = "Vert", #"Night Blue" = "Bleu nuit", #"Pink" = "Rose", #"Red" = "Rouge", #"Silver" = "Argent"],
				    CouleurFr = (c) => if c = null then "Non renseignée" else Record.FieldOrDefault(CouleursFr, Text.Trim(c), Text.Trim(c)),
				    Pays0 = Source{[Schema = "Data", Item = "Country"]}[Data],
				    NomFr = [BE = "Belgique", FR = "France", DE = "Allemagne", IT = "Italie", ES = "Espagne", GB = "Royaume-Uni", US = "États-Unis", CN = "Chine", IN = "Inde", CH = "Suisse"],
				    RegionFr = [EMEA = "Europe", #"North America" = "Amérique du Nord", Asia = "Asie"],
				    Drapeaux = [#"BE" = "data:image/png;base64,", #"FR" = "data:image/png;base64,", #"DE" = "data:image/png;base64,", #"IT" = "data:image/png;base64,", #"ES" = "data:image/png;base64,", #"GB" = "data:image/png;base64,", #"US" = "data:image/png;base64,", #"CN" = "data:image/png;base64,", #"IN" = "data:image/png;base64,", #"CH" = "data:image/png;base64,"],
				    Lignes = List.Transform(Table.ToRecords(Pays0), (r) => let iso = T(r[CountryISO2]) in
				        [ISO2 = iso, Pays = Record.FieldOrDefault(NomFr, iso, T(r[CountryName])), Region = Record.FieldOrDefault(RegionFr, T(r[SalesRegion]), T(r[SalesRegion])), NomAnglais = T(r[CountryName]), Drapeau = Record.FieldOrDefault(Drapeaux, iso, null)]),
				    Tableau = Table.FromRecords(Lignes),
				    Types = Table.TransformColumnTypes(Tableau, {{"ISO2", type text}, {"Pays", type text}, {"Region", type text}, {"NomAnglais", type text}, {"Drapeau", type text}}, "en-US")
				in
				    Types

	annotation PBI_ResultType = Table
