	column Statut
		dataType: string
		lineageTag: 67363041-c351-59ae-8e70-d10d0f8904b5
		summarizeBy: none
		sourceColumn: Statut

		annotation SummarizationSetBy = Automatic

	column 'Âge (jours)'
		dataType: int64
		formatString: 0
		lineageTag: a84d89fc-9d41-5770-a816-9708de6767ee
		summarizeBy: none
		sourceColumn: Age

		annotation SummarizationSetBy = Automatic

	partition F_Stock = m
		mode: import
		source =
				let
				    Source = Sql.Database(Serveur, Base),
				    N = (x) => if x = null then 0 else Number.From(x),
				    T = (x) => if x = null then null else Text.Trim(Text.From(x)),
				    CouleursFr = [#"Black" = "Noir", #"Blue" = "Bleu", #"British Racing Green" = "Vert anglais", #"Canary Yellow" = "Jaune canari", #"Dark Purple" = "Pourpre", #"Green" = "Vert", #"Night Blue" = "Bleu nuit", #"Pink" = "Rose", #"Red" = "Rouge", #"Silver" = "Argent"],
				    CouleurFr = (c) => if c = null then "Non renseignée" else Record.FieldOrDefault(CouleursFr, Text.Trim(c), Text.Trim(c)),
				    Stock0 = Source{[Schema = "Data", Item = "Stock"]}[Data],
				    Lignes0 = Source{[Schema = "Data", Item = "SalesDetails"]}[Data],
				    Vendus = List.Buffer(List.Transform(Lignes0[StockID], each Text.Trim(_))),
				    Fin = #date(2018, 12, 31),
				    Lignes = List.Transform(Table.ToRecords(Stock0), (r) =>
				        let id = T(r[StockCode]), v = List.Contains(Vendus, id), a = Date.From(r[DateBought]),
				            ca = N(r[Cost]), tot = ca + N(r[RepairsCost]) + N(r[PartsCost]) + N(r[TransportInCost])
				        in [StockID = id, ModeleID = if r[ModelID] = null then -1 else Int64.From(r[ModelID]), CoutAchat = ca, CoutTotal = tot, DateAchat = a,
				            Couleur = CouleurFr(r[Color]), Statut = if v then "Vendue" else "En stock",
				            Age = if v then null else Duration.Days(Fin - a)]),
				    Tableau = Table.FromRecords(Lignes),
				    Types = Table.TransformColumnTypes(Tableau, {{"StockID", type text}, {"ModeleID", Int64.Type}, {"CoutAchat", type number}, {"CoutTotal", type number}, {"DateAchat", type date}, {"Couleur", type text}, {"Statut", type text}, {"Age", Int64.Type}}, "en-US")
				in
				    Types

	annotation PBI_ResultType = Table
