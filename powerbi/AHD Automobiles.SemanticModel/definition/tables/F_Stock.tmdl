table F_Stock
	lineageTag: d1c2945e-52e0-558b-86db-f289db7df9f9

	column StockID
		dataType: string
		isHidden
		lineageTag: c7d9b228-f4e6-5113-a36d-fb3a52e92d98
		summarizeBy: none
		sourceColumn: StockID

		annotation SummarizationSetBy = Automatic

	column ModeleID
		dataType: int64
		formatString: 0
		isHidden
		lineageTag: b6b622f2-c225-5841-a2f1-81f5e1450f40
		summarizeBy: none
		sourceColumn: ModeleID

		annotation SummarizationSetBy = Automatic

	column 'Coût achat'
		dataType: double
		formatString: #,0" £"
		lineageTag: 18e0d8bf-ce3a-5576-ae3d-35917e440d77
		summarizeBy: sum
		sourceColumn: CoutAchat

		annotation SummarizationSetBy = Automatic

	column 'Coût total'
		dataType: double
		formatString: #,0" £"
		lineageTag: fef56fbc-763b-5c6f-831e-9931157a7945
		summarizeBy: sum
		sourceColumn: CoutTotal

