	partition D_Modele = m
		mode: import
		source =
				let
				    Source = Sql.Database(Serveur, Base),
				    N = (x) => if x = null then 0 else Number.From(x),
				    T = (x) => if x = null then null else Text.Trim(Text.From(x)),
				    CouleursFr = [#"Black" = "Noir", #"Blue" = "Bleu", #"British Racing Green" = "Vert anglais", #"Canary Yellow" = "Jaune canari", #"Dark Purple" = "Pourpre", #"Green" = "Vert", #"Night Blue" = "Bleu nuit", #"Pink" = "Rose", #"Red" = "Rouge", #"Silver" = "Argent"],
				    CouleurFr = (c) => if c = null then "Non renseignée" else Record.FieldOrDefault(CouleursFr, Text.Trim(c), Text.Trim(c)),
				    Modeles0 = Source{[Schema = "Data", Item = "Model"]}[Data],
				    Marques0 = Source{[Schema = "Data", Item = "Make"]}[Data],
				    Cat0 = Source{[Schema = "Reference", Item = "MarketingCategories"]}[Data],
				    // Corrections d'origine : Peugeot est français, Reliant et Lagonda sont britanniques
				    Corrige = [Peugeot = "FRA", Reliant = "GBR", Lagonda = "GBR"],
				    PaysFr = [ITA = "Italie", GER = "Allemagne", GBR = "Royaume-Uni", FRA = "France", USA = "États-Unis"],
				    CatFr = [Sports = "Sport", Tourer = "Grand tourisme", Chauffer = "Avec chauffeur", Prestige = "Prestige", Relic = "Collection", Family = "Familiale"],
				    CatDe = (nom) => let r = Table.SelectRows(Cat0, each Text.Trim([MakeName]) = nom) in if Table.IsEmpty(r) then {} else List.Transform(Text.Split(Text.Trim(r{0}[MarketingType]), ","), each Record.FieldOrDefault(CatFr, Text.Trim(_), Text.Trim(_))),
				    MarqueDe = Record.FromList(List.Transform(Table.ToRecords(Marques0), each [Nom = Text.Trim([MakeName]), Pays = Text.Trim([MakeCountry])]), List.Transform(Marques0[MakeID], each Text.From(_))),
				    Lignes = List.Transform(Table.ToRecords(Modeles0), (r) =>
				        let mk = Record.Field(MarqueDe, Text.From(r[MakeID])), cp = Record.FieldOrDefault(Corrige, mk[Nom], mk[Pays]), c = CatDe(mk[Nom])
				        in [ModeleID = Int64.From(r[ModelID]), Modele = T(r[ModelName]), Marque = mk[Nom], Origine = Record.FieldOrDefault(PaysFr, cp, cp),
				            Categorie = if List.IsEmpty(c) then "Autre" else c{0}, Categories = Text.Combine(c, ", "),
				            ModeleComplet = mk[Nom] & " " & T(r[ModelName])]),
				    // modèles présents dans le stock mais absents du référentiel : rattachés à une marque « Non référencée »
				    Stock0 = Source{[Schema = "Data", Item = "Stock"]}[Data],
				    Connus = List.Transform(Modeles0[ModelID], each Int64.From(_)),
				    Orphelins = List.Difference(List.Distinct(List.Transform(Stock0[ModelID], each if _ = null then -1 else Int64.From(_))), Connus),
				    LignesOrph = List.Transform(Orphelins, (i) => [ModeleID = i, Modele = "Modèle non référencé", Marque = "Non référencée", Origine = "Non renseignée",
				        Categorie = "Autre", Categories = "Non renseigné", ModeleComplet = "Modèle non référencé (" & Text.From(i) & ")"]),
				    Logos = [#"Noble" = "data:image/png;base64,", #"Rolls Royce" = "data:image/png;base64,", #"Ferrari" = "data:image/png;base64,", #"Jaguar" = "data:image/png;base64,", #"Morgan" = "data:image/png;base64,", #"Peugeot" = "data:image/png;base64,", #"Trabant" = "data:image/png;base64,", #"BMW" = "data:image/png;base64,", #"Bugatti" = "data:image/png;base64,", #"Delahaye" = "data:image/png;base64,", #"Mercedes" = "data:image/png;base64,", #"Cadillac" = "data:image/png;base64,", #"Alfa Romeo" = "data:image/png;base64,", #"Riley" = "data:image/png;base64,", #"Bentley" = "data:image/png;base64,", #"Aston Martin" = "data:image/png;base64,", #"Lagonda" = "data:image/png;base64,", #"Citroen" = "data:image/png;base64,", #"Lamborghini" = "data:image/png;base64,", #"McLaren" = "data:image/png;base64,", #"Triumph" = "data:image/png;base64,", #"Delorean" = "data:image/png;base64,", #"Porsche" = "data:image/png;base64,", #"Austin" = "data:image/png;base64,", #"Reliant" = "data:image/png;base64,", #"Maybach" = "data:image/png;base64,", #"Non référencée" = "data:image/png;base64,"],
				    Tableau0 = Table.FromRecords(Lignes & LignesOrph),
				    Tableau = Table.AddColumn(Tableau0, "Logo", each Record.FieldOrDefault(Logos, [Marque], Record.Field(Logos, "Non référencée")), type text),
				    Types = Table.TransformColumnTypes(Tableau, {{"ModeleID", Int64.Type}, {"Modele", type text}, {"Marque", type text}, {"Origine", type text}, {"Categorie", type text}, {"Categories", type text}, {"ModeleComplet", type text}, {"Logo", type text}}, "en-US")
				in
				    Types

	annotation PBI_ResultType = Table
